<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/firstFragment">

    <!-- First Fragment (Splash/Start) -->
    <fragment
        android:id="@+id/firstFragment"
        android:name="com.example.myapplication.FirstFragment"
        android:label="First Fragment"
        tools:layout="@layout/fragment_first">

        <!-- Navigate to Tutorial Fragment after splash screen -->
        <action
            android:id="@+id/action_firstFragment_to_fragment_tutorial"
            app:destination="@id/fragment_tutorial"/>
    </fragment>

    <!-- Tutorial Fragment -->
    <fragment
        android:id="@+id/fragment_tutorial"
        android:name="com.example.myapplication.fragment_tutorial"
        android:label="Tutorial Fragment"
        tools:layout="@layout/fragment_tutorial"/>

</navigation>
