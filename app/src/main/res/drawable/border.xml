<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Border thickness and color -->
    <stroke
        android:width="3dp"
        android:color="#FF5722" />  <!-- Orange border color -->

    <!-- Background color inside the border -->
    <solid android:color="#FFFFFF" />  <!-- White background -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Padding inside the border (optional) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
